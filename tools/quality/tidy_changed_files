#!/usr/bin/env python3
"""Run clang-tidy over only the translation units a change touches.

The presets enable clang-tidy during compilation, which analyzes every translation unit and
dominates the Linux jobs. Pull requests only need the units they change analyzed; the full sweep
still runs when the change lands. This tool reads the compilation database, maps the diff to the
units it touches (a changed header selects the units that include it), and runs the same
clang-tidy invocation the build uses, in parallel.
"""

from __future__ import annotations

import argparse
import concurrent.futures
import json
import os
import subprocess
import sys
from pathlib import Path

HEADER_SUFFIXES = {".h", ".hh", ".hpp", ".hxx", ".inl", ".ipp"}
SOURCE_SUFFIXES = {".c", ".cc", ".cpp", ".cxx", ".mm"}


def parse_arguments() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--compile-database", required=True, type=Path)
    parser.add_argument("--checks", required=True)
    parser.add_argument("--header-filter", required=True)
    parser.add_argument("--base", help="Revision to diff the working commit against")
    parser.add_argument("--changed-file", action="append", default=[], type=Path)
    parser.add_argument("--clang-tidy", default="clang-tidy-22")
    parser.add_argument("--jobs", type=int, default=os.cpu_count() or 1)
    parser.add_argument("--dry-run", action="store_true", help="List the selected units and stop")
    return parser.parse_args()


def changed_paths(arguments: argparse.Namespace) -> list[Path]:
    if arguments.changed_file:
        return [path.resolve() for path in arguments.changed_file]
    if not arguments.base:
        raise SystemExit("either --base or --changed-file is required")
    completed = subprocess.run(
        ["git", "diff", "--name-only", "--diff-filter=ACMR", arguments.base, "HEAD"],
        check=True,
        capture_output=True,
        text=True,
    )
    return [Path(line).resolve() for line in completed.stdout.splitlines() if line]


def select_units(database: Path, changed: list[Path]) -> list[Path]:
    entries = json.loads(database.read_text(encoding="utf-8"))
    units = {Path(entry["file"]).resolve() for entry in entries}

    selected: set[Path] = set()
    headers: list[Path] = []
    for path in changed:
        if path in units:
            selected.add(path)
        elif path.suffix.lower() in HEADER_SUFFIXES and path.exists():
            headers.append(path)

    # A header is only analyzed while a unit that includes it is analyzed. Select those units by
    # matching the header's repository path or file name, which covers both quoted and angled
    # includes. The match is deliberately broad: extra units cost time, a missed unit costs
    # coverage.
    needles: set[str] = set()
    for header in headers:
        needles.add(header.name)
        needles.add(str(header))
        try:
            needles.add(str(header.relative_to(Path.cwd())))
        except ValueError:
            pass
    if needles:
        for unit in units:
            if not unit.exists():
                continue
            try:
                text = unit.read_text(encoding="utf-8", errors="ignore")
            except OSError:
                continue
            if any(needle in text for needle in needles):
                selected.add(unit)

    return sorted(selected)


def run_one(
    clang_tidy: str,
    database: Path,
    checks: str,
    header_filter: str,
    unit: Path,
) -> tuple[Path, int, str]:
    completed = subprocess.run(
        [
            clang_tidy,
            f"--checks={checks}",
            "--warnings-as-errors=*",
            f"--header-filter={header_filter}",
            "-p",
            str(database.parent),
            str(unit),
        ],
        capture_output=True,
        text=True,
    )
    return unit, completed.returncode, completed.stdout + completed.stderr


def main() -> int:
    arguments = parse_arguments()
    if not arguments.compile_database.is_file():
        raise SystemExit(f"compilation database not found: {arguments.compile_database}")

    units = select_units(arguments.compile_database, changed_paths(arguments))
    if not units:
        print("clang-tidy: no changed translation units")
        return 0

    if arguments.dry_run:
        for unit in units:
            print(unit)
        return 0

    print(f"clang-tidy: analyzing {len(units)} changed translation unit(s)")
    failures = 0
    with concurrent.futures.ThreadPoolExecutor(max_workers=max(1, arguments.jobs)) as pool:
        futures = [
            pool.submit(
                run_one,
                arguments.clang_tidy,
                arguments.compile_database,
                arguments.checks,
                arguments.header_filter,
                unit,
            )
            for unit in units
        ]
        for future in concurrent.futures.as_completed(futures):
            unit, returncode, output = future.result()
            if returncode == 0:
                continue
            failures += 1
            sys.stderr.write(f"clang-tidy failed for {unit}:\n{output}\n")
    if failures:
        print(f"clang-tidy: {failures} translation unit(s) failed", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
