{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kinetik:bloom:schema:project-manifest:1.9",
  "title": "Bloom Project Manifest for Document 1.9",
  "$comment": "Document 1.9 adds independent component animation keys for vector and colour curves. Missing settings use the default 90% action-safe and 80% title-safe guides; authored settings are validated by Project I/O.",
  "type": "object",
  "required": [
    "format",
    "containerVersion",
    "document",
    "requirements"
  ],
  "properties": {
    "format": {
      "const": "org.kinetik.bloom.project"
    },
    "containerVersion": {
      "$ref": "#/$defs/fixedVersion-1.0"
    },
    "document": {
      "$ref": "#/$defs/document-1.0"
    },
    "requirements": {
      "type": "array",
      "maxItems": 1000000,
      "items": {
        "$ref": "#/$defs/requirement-1.0"
      }
    }
  },
  "$defs": {
    "unsigned32": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "positiveMajorVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "namespacedIdentifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "fixedVersion-1.0": {
      "type": "object",
      "required": [
        "major",
        "minor"
      ],
      "properties": {
        "major": {
          "const": 1
        },
        "minor": {
          "const": 0
        }
      },
      "unevaluatedProperties": true
    },
    "requirementVersion-1.0": {
      "type": "object",
      "required": [
        "major",
        "minor"
      ],
      "properties": {
        "major": {
          "$ref": "#/$defs/positiveMajorVersion"
        },
        "minor": {
          "$ref": "#/$defs/unsigned32"
        }
      },
      "unevaluatedProperties": true
    },
    "document-1.0": {
      "type": "object",
      "required": [
        "path",
        "schemaVersion"
      ],
      "properties": {
        "path": {
          "const": "document.json"
        },
        "schemaVersion": {
          "$ref": "#/$defs/fixedVersion-1.9"
        }
      },
      "unevaluatedProperties": true
    },
    "requirement-1.0": {
      "type": "object",
      "required": [
        "providerId",
        "capabilityId",
        "schemaVersion",
        "providedNodeTypeIds"
      ],
      "properties": {
        "providerId": {
          "$ref": "#/$defs/namespacedIdentifier"
        },
        "capabilityId": {
          "$ref": "#/$defs/namespacedIdentifier"
        },
        "schemaVersion": {
          "$ref": "#/$defs/requirementVersion-1.0"
        },
        "providedNodeTypeIds": {
          "type": "array",
          "maxItems": 1000000,
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/namespacedIdentifier"
              },
              {
                "not": {
                  "enum": [
                    "bloom.composition-output",
                    "bloom.layer-output",
                    "bloom.layer-stack",
                    "bloom.solid-source",
                    "bloom.text-source"
                  ]
                }
              }
            ]
          }
        }
      },
      "unevaluatedProperties": true
    },
    "fixedVersion-1.9": {
      "type": "object",
      "required": [
        "major",
        "minor"
      ],
      "properties": {
        "major": {
          "const": 1
        },
        "minor": {
          "const": 9
        }
      },
      "unevaluatedProperties": false
    }
  },
  "unevaluatedProperties": true
}
