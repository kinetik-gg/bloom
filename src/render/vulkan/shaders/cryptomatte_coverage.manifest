  "contracts": {
    "numeric": "bit-exact against the Cryptomatte CPU reference (src/runtime/cryptomatte.cpp): in rank order c = clamp(c + (ID bits selected ? coverage : 0), 0, 1) in binary32, then (c, c, c, c)",
