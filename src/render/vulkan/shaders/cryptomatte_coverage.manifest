     "role": "stacked-cryptomatte-rank-pairs (R = ID bits, G = coverage)"},
    {"set": 0, "binding": 1, "kind": "storage-image", "access": "writeonly", "format": "rgba32f",
     "role": "premultiplied-white-coverage-mask (mode 0) or premultiplied ID-colour preview (mode 1)"},
    {"set": 0, "binding": 2, "kind": "storage-buffer", "access": "readonly", "element": "uint",
