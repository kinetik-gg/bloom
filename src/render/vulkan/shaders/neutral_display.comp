// Exact replica of the CPU straight-RGBA8 rule
//   floor(clamp(value, 0, 1) * 255.0 + 0.5)
// evaluated with the exact binary64 value of the binary32 input. The input significand
// has at most 24 bits and 255 is odd, so value * 255 is exactly representable in
// binary64; frexp plus integer arithmetic reproduces the binary64 floor, half-up, without
// requiring shaderFloat64. The only exact tie is value == 0.5 and it rounds up to 128.
uint bloom_neutral_v1_quantize_byte(float value)
{
    if (!(value > 0.0)) { return 0u; }
    if (value >= 1.0) { return 255u; }
    if (value < 0.001) { return 0u; }
    int exponent = 0;
    float significand = frexp(value, exponent);
    uint mantissa = uint(significand * 16777216.0);
    uint scaled = mantissa * 255u;
    int shift = 24 - exponent;
    if (shift >= 33) { return 0u; }
    if (shift == 32) { return (scaled >= 0x80000000u) ? 1u : 0u; }
    uint quotient = scaled >> uint(shift);
    uint remainder = scaled & ((1u << uint(shift)) - 1u);
    uint roundBit = 1u << uint(shift - 1);
    return quotient + ((remainder >= roundBit) ? 1u : 0u);
}


