#version 460
// Bloom AffineBilinearV1 compute shader. Offline-generated/embedded; do not edit at runtime.
// Operation: AffineBilinearV1.
//
// Mirrors render::layerTransformBilinearRow() (src/render/cpu_image_primitives.cpp) and the
// parented row (src/runtime/layer_parent_transform.hpp) for the RGBA32F reference-parity profile.
// The CPU primitives are the oracle; this shader must stay within the documented per-component
// 2e-6 absolute-or-relative gate (docs/architecture/gpu-backend.md), never bit-exact by claim.
//
// SAMPLE POINT PRECISION. A general affine inverse map is computed on the host in Float64 (the
// exact oracle arithmetic: LayerTransform::inverseMap() or the closed-form inverse of a composed
// 2x3 matrix) and reduced, per output pixel, to the exact CPU floor/factor pair:
//   base  = (int64)floor(sampleLocal)
//   factor = (float)(sampleLocal - (double)base)
// The host emits one BloomAffineSample per output pixel and uploads it as a bounded O(outputWidth
// * outputHeight) storage buffer. The kernel only gathers the prepared base/factor pair; it never
// re-derives the sample point and needs no shaderFloat64. This is coordinate metadata only -- no
// per-pixel RGBA is generated and no CPU resampling happens on the host.
//
// Sample entry: { int baseX; int baseY; float factorX; float factorY; }. baseX == INT_MIN is the
// out-of-range sentinel (the CPU's `sample.x <= -1.0 || >= width || sample.y <= -1.0 || >=
// height` transparent branch), which yields exact transparent black for that pixel. base +/- 1
// taps outside the source data window are transparent too.
//
// Arithmetic policy: the CPU interpolates with std::fma(factor, end, (1 - factor) * start); the
// shader evaluates the same expression with GLSL fma(). Tap selection, the sample point, floor,
// factor, opacity multiply, and the transparent-border rule are exact.
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba32f) uniform readonly image2D bloom_affine_input;
layout(set = 0, binding = 1, rgba32f) uniform writeonly image2D bloom_affine_output;
struct BloomAffineSample { int baseX; int baseY; float factorX; float factorY; };
layout(set = 0, binding = 2, std430) readonly buffer BloomAffineSamples {
    BloomAffineSample samples[];
} bloom_affine_samples;
// flags[0] bit0 non-finite input, bit1 non-finite result, bit2 any nonzero subnormal input lane.
layout(set = 0, binding = 3) buffer BloomAffineError { uint flags[]; } bloom_error;

layout(push_constant) uniform BloomAffinePushConstants {
    uint outputWidth;    // output data-window width/height
    uint outputHeight;
    uint sourceWidth;    // source data-window width/height
    uint sourceHeight;
    float opacity;       // float32 opacity, already rounded once on the host
} bloom_affine_push;

const int kSentinelBase = -2147483648;
const uint kErrorInputNonFinite = 1u;
const uint kErrorResultNonFinite = 2u;
const uint kErrorInputSubnormal = 4u;

bool bloom_is_subnormal(float value)
{
    uint bits = floatBitsToUint(value) & 0x7FFFFFFFu;
    return bits != 0u && bits < 0x00800000u;
}

uint bloom_lane_errors(vec4 value)
{
    uint errors = 0u;
    if (any(isnan(value)) || any(isinf(value))) { errors |= kErrorInputNonFinite; }
    if (bloom_is_subnormal(value.x) || bloom_is_subnormal(value.y) ||
        bloom_is_subnormal(value.z) || bloom_is_subnormal(value.w)) {
        errors |= kErrorInputSubnormal;
    }
    return errors;
}

vec4 bloom_fetch(int x, int y)
{
    if (x < 0 || y < 0 || x >= int(bloom_affine_push.sourceWidth) ||
        y >= int(bloom_affine_push.sourceHeight)) {
        return vec4(0.0);
    }
    return imageLoad(bloom_affine_input, ivec2(x, y));
}

float bloom_lerp(float start, float end, float factor)
{
    if (factor == 0.0) { return start; }
    if (factor == 1.0) { return end; }
    return fma(factor, end, (1.0 - factor) * start);
}

vec4 bloom_bilerp(vec4 topLeft, vec4 topRight, vec4 bottomLeft, vec4 bottomRight,
                  float fx, float fy)
{
    vec4 top = vec4(bloom_lerp(topLeft.x, topRight.x, fx),
                    bloom_lerp(topLeft.y, topRight.y, fx),
                    bloom_lerp(topLeft.z, topRight.z, fx),
                    bloom_lerp(topLeft.w, topRight.w, fx));
    vec4 bottom = vec4(bloom_lerp(bottomLeft.x, bottomRight.x, fx),
                       bloom_lerp(bottomLeft.y, bottomRight.y, fx),
                       bloom_lerp(bottomLeft.z, bottomRight.z, fx),
                       bloom_lerp(bottomLeft.w, bottomRight.w, fx));
    return vec4(bloom_lerp(top.x, bottom.x, fy),
                bloom_lerp(top.y, bottom.y, fy),
                bloom_lerp(top.z, bottom.z, fy),
                bloom_lerp(top.w, bottom.w, fy));
}

void main()
{
    uvec2 index = gl_GlobalInvocationID.xy;
    if (index.x >= bloom_affine_push.outputWidth ||
        index.y >= bloom_affine_push.outputHeight) {
        return;
    }
    ivec2 outputLocal = ivec2(index);
    vec4 transparent = vec4(0.0);

    if (bloom_affine_push.opacity == 0.0) {
        imageStore(bloom_affine_output, outputLocal, transparent);
        return;
    }

    BloomAffineSample entry =
        bloom_affine_samples.samples[index.y * bloom_affine_push.outputWidth + index.x];
    if (entry.baseX == kSentinelBase) {
        imageStore(bloom_affine_output, outputLocal, transparent);
        return;
    }

    vec4 topLeft = bloom_fetch(entry.baseX, entry.baseY);
    vec4 topRight = bloom_fetch(entry.baseX + 1, entry.baseY);
    vec4 bottomLeft = bloom_fetch(entry.baseX, entry.baseY + 1);
    vec4 bottomRight = bloom_fetch(entry.baseX + 1, entry.baseY + 1);

    vec4 taps[4] = vec4[4](topLeft, topRight, bottomLeft, bottomRight);
    uint errors = 0u;
    for (int tap = 0; tap < 4; ++tap) {
        errors |= bloom_lane_errors(taps[tap]);
    }
    if (errors != 0u) {
        atomicOr(bloom_error.flags[0], errors);
        imageStore(bloom_affine_output, outputLocal, transparent);
        return;
    }

    vec4 sampled = bloom_bilerp(topLeft, topRight, bottomLeft, bottomRight,
                                entry.factorX, entry.factorY);
    if (bloom_affine_push.opacity != 1.0) {
        sampled *= bloom_affine_push.opacity;
    }
    if (any(isnan(sampled)) || any(isinf(sampled))) {
        atomicOr(bloom_error.flags[0], kErrorResultNonFinite);
        imageStore(bloom_affine_output, outputLocal, transparent);
        return;
    }
    imageStore(bloom_affine_output, outputLocal, sampled);
}
