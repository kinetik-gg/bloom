  "hostDerivation": {
    "axisX": "prepareTranslationAxis(outputWidth, sourceWidth, translationX): exact Float64 sampleLocal=local-translation, sentinel when sampleLocal<=-1.0 or >= sourceExtent, else base=(int64)floor and factor=(float)(sampleLocal-base)",
    "axisY": "prepareTranslationAxis(outputHeight, sourceHeight, translationY)",
    "sentinel": "base==INT_MIN means transparent for that row/column; base+1 taps outside the source data window are transparent",
    "opacity": "TranslationOpacity::opacity() is the float32 binding",
    "checked": "dispatch ceil(outputWidth*outputHeight/256); host preflights the image + metadata budget and device limits"
