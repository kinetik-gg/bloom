  "contracts": {
    "numeric": "per-finite-component abs-or-rel 2e-6 against render::translateOpacityBilinearRow; never bit-exact by claim",
    "arithmetic": "CPU uses std::fma(factor,end,(1-factor)*start); shader uses fma() for the same lerp; SPIR-V relaxed contraction is covered by the 2e-6 gate",
    "sampleConvention": "kernel gathers the host-prepared base/factor; it never re-derives the sample point and needs no float64. This removes the Float32 subtraction precision loss at large output coordinates.",
    "opacity": "opacity==0 writes transparent; opacity==1 skips the multiply; otherwise sampled *= opacity",
    "nonFinitePolicy": "any non-finite tap sets bit0, any nonzero subnormal tap sets bit2, a non-finite result sets bit1; on any error the output pixel is transparent and the consumer must not publish while flags[0] != 0",
    "cpuFallback": "non-finite/subnormal domains and any precision the shader cannot match stay on the CPU reference path; no silent substitution",
    "metadataBudget": "axis arrays are O(outputWidth+outputHeight) BloomAxisSample (8 bytes each), charged against maxMetadataBytes and the per-call byteBudget"
