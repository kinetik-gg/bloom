  "hostDerivation": {
    "axisMaps": "preparePointResampleAxisMaps(sourceWidth, sourceHeight, outputWidth, outputHeight, horizontalScale, verticalScale): for every output column x compute min(sourceWidth-1, (uint32)(double(x)/horizontalScale)) and for every output row y compute min(sourceHeight-1, (uint32)(double(y)/verticalScale)), the exact media-image-proxy CPU oracle arithmetic; the two independent maps total O(outputWidth + outputHeight) int32 values and no per-pixel RGBA is generated or sampled on the host",
    "outputWindow": "max(1, ceil(sourceWidth*horizontalScale)) x max(1, ceil(sourceHeight*verticalScale)), origin (0, 0); the display window and pixel aspect are preserved from the composition descriptor",
    "checked": "the output pixel space is flattened row-major into 256-wide workgroups; the host dispatches (groupsX, groupsY) with groupsX clamped to maxComputeWorkGroupCount[0] and the remainder carried in Y, so a frame whose X workgroup count exceeds the physical X limit is still dispatched. The host preflights scales, output geometry, device limits, the image/metadata byte budget, and the workgroup-grid capacity before allocating"
  },
  "contracts": {
    "numeric": "bit-exact against the media-image-proxy CPU oracle (src/runtime/image_source.cpp evaluateImageSource); the kernel is a pure rgba32f imageLoad/imageStore with no arithmetic, so every source bit including non-finite, subnormal, negative, HDR, and alpha is preserved exactly",
    "sampleConvention": "the kernel gathers the host-prepared per-output-axis source indices; it never re-derives the double division and needs no shaderFloat64, so large-coordinate precision matches the CPU oracle",
    "alphaAndHdr": "alpha, negative, and HDR lanes are copied unchanged; no colour transform, no unpremultiply, no clamp",
    "sourceOrigin": "indices are data-window-relative; a nonzero or negative source data-window origin does not change the mapping, exactly as the CPU oracle indexes relative to the data window",
    "errorPolicy": "no error-flag buffer and no status rejection: the operation is a bit copy, so it cannot introduce a non-finite or subnormal value the CPU oracle would not also copy",
    "metadataBudget": "the axis-map array is O(outputWidth + outputHeight) int32 against maxMetadataBytes and the per-call byteBudget; it is coordinate metadata only, never CPU-generated RGBA",
    "cpuFallback": "an invalid scale/geometry, a device-limit or budget refusal, a foreign device, or a wrong thread fails closed with an explicit diagnostic; no silent CPU substitution"
  }
