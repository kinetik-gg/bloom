  "contracts": {
    "alignment": "Second input sampled at the base image's global integer pixel coordinate; outside its data window is transparent black",
    "alpha": "finite premultiplied RGBA32F; matte RGB channel extraction uses straight scene-linear colour and zero coverage for zero alpha",
    "nonFinitePolicy": "input non-finite/subnormal or non-finite result sets a status flag; never publish a flagged image",
    "modes": "8 Image Mix; 9 Set Alpha; 10 Multiply Alpha",
    "channel": "bits 0-2 select A, R, G, B or scene-linear luma; bit 3 inverts the unit coverage",
    "absentMatte": "an empty source extent makes every tap transparent black (zero coverage)",
    "mask": "Image Mix only: maskMode 1 scales the factor by the mask alpha at the base pixel's global coordinate (zero outside its data window); 2 is an absent mask (zero); 0 ignores binding 4"
  }
