  "bindings": [
    {"set": 0, "binding": 0, "kind": "storage-image", "access": "readonly", "format": "rgba32f", "role": "second-image-or-matte"},
    {"set": 0, "binding": 1, "kind": "storage-image", "access": "readonly", "format": "rgba32f", "role": "base-image"},
    {"set": 0, "binding": 2, "kind": "storage-image", "access": "writeonly", "format": "rgba32f", "role": "premultiplied-output"},
    {"set": 0, "binding": 3, "kind": "storage-buffer", "access": "readwrite", "element": "uint", "role": "error-flag"},
