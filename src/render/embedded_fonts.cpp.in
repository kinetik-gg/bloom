#include <bloom/render/embedded_fonts.hpp>

namespace bloom::render {
namespace {

constexpr std::uint8_t kDejaVuSansTrueTypeBytes[] = {
@BLOOM_DEJAVUSANS_PAYLOAD_BYTES@
};
constexpr std::uint8_t kInterRegularTrueTypeBytes[] = {
@BLOOM_INTERREGULAR_PAYLOAD_BYTES@
};
constexpr std::uint8_t kInterMediumTrueTypeBytes[] = {
@BLOOM_INTERMEDIUM_PAYLOAD_BYTES@
};
constexpr std::uint8_t kInterSemiBoldTrueTypeBytes[] = {
@BLOOM_INTERSEMIBOLD_PAYLOAD_BYTES@
};

static_assert(sizeof(kDejaVuSansTrueTypeBytes) == @BLOOM_DEJAVUSANS_BYTE_COUNT@,
              "the embedded DejaVu Sans payload lost bytes between CMake and the compiler");
static_assert(sizeof(kInterRegularTrueTypeBytes) == @BLOOM_INTERREGULAR_BYTE_COUNT@,
              "the embedded Inter Regular payload lost bytes between CMake and the compiler");
static_assert(sizeof(kInterMediumTrueTypeBytes) == @BLOOM_INTERMEDIUM_BYTE_COUNT@,
              "the embedded Inter Medium payload lost bytes between CMake and the compiler");
static_assert(sizeof(kInterSemiBoldTrueTypeBytes) == @BLOOM_INTERSEMIBOLD_BYTE_COUNT@,
              "the embedded Inter SemiBold payload lost bytes between CMake and the compiler");

} // namespace

std::span<const std::uint8_t> embeddedFaceBytes(const EmbeddedFace face) noexcept {
    switch (face) {
    case EmbeddedFace::DejaVuSans:
        return {kDejaVuSansTrueTypeBytes, sizeof(kDejaVuSansTrueTypeBytes)};
    case EmbeddedFace::InterRegular:
        return {kInterRegularTrueTypeBytes, sizeof(kInterRegularTrueTypeBytes)};
    case EmbeddedFace::InterMedium:
        return {kInterMediumTrueTypeBytes, sizeof(kInterMediumTrueTypeBytes)};
    case EmbeddedFace::InterSemiBold:
        return {kInterSemiBoldTrueTypeBytes, sizeof(kInterSemiBoldTrueTypeBytes)};
    }
    return {};
}

} // namespace bloom::render
