# Bundled codec boundary (ADR 0036). OpenH264 and the other permissive codec libraries are static
# archives linked into libavcodec: the prefix carries no codec shared library, libavcodec names
# none in DT_NEEDED and exports none of their symbols, and the worker's private runtime directory
# holds no codec library or loader shim of its own.
if(NOT DEFINED BLOOM_DEPENDENCY_PREFIX)
    message(FATAL_ERROR "BLOOM_DEPENDENCY_PREFIX is required")
endif()

set(codec_libraries openh264 kvazaar dav1d)
foreach(codec IN LISTS codec_libraries)
    file(GLOB codec_shared "${BLOOM_DEPENDENCY_PREFIX}/lib/lib${codec}.so*")
    if(codec_shared)
        message(FATAL_ERROR "The dependency prefix carries a shared ${codec}: ${codec_shared}")
    endif()
endforeach()

file(GLOB avcodec_files "${BLOOM_DEPENDENCY_PREFIX}/lib/libavcodec.so.*")
if(NOT avcodec_files)
    message(FATAL_ERROR "FFmpeg avcodec shared object is absent")
endif()
list(SORT avcodec_files)
list(GET avcodec_files 0 avcodec)
execute_process(COMMAND readelf -d "${avcodec}" OUTPUT_VARIABLE dynamic OUTPUT_STRIP_TRAILING_WHITESPACE
                RESULT_VARIABLE readelf_status)
if(NOT readelf_status EQUAL 0)
    message(FATAL_ERROR "readelf could not inspect FFmpeg avcodec")
endif()
foreach(codec IN LISTS codec_libraries)
    if(dynamic MATCHES "NEEDED[^\n]*lib${codec}\\.")
        message(FATAL_ERROR "FFmpeg avcodec loads lib${codec} at run time; it must be linked in")
    endif()
endforeach()
if(dynamic MATCHES "(RPATH|RUNPATH)")
    message(FATAL_ERROR "FFmpeg avcodec has a runtime search path")
endif()
execute_process(COMMAND nm -D --defined-only "${avcodec}" OUTPUT_VARIABLE exports
                OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE nm_status)
if(NOT nm_status EQUAL 0)
    message(FATAL_ERROR "nm could not inspect FFmpeg avcodec")
endif()
if(exports MATCHES " (Wels[A-Za-z]|kvz_|dav1d_)")
    message(FATAL_ERROR "FFmpeg avcodec exports bundled codec symbols")
endif()
message(STATUS "Codec boundary passed: codecs are linked into libavcodec and stay private")

if(DEFINED BLOOM_MEDIA_WORKER_RUNTIME)
    if(NOT IS_DIRECTORY "${BLOOM_MEDIA_WORKER_RUNTIME}")
        message(FATAL_ERROR "The worker runtime directory is absent")
    endif()
    foreach(codec IN LISTS codec_libraries)
        file(GLOB worker_codec "${BLOOM_MEDIA_WORKER_RUNTIME}/lib${codec}*")
        if(worker_codec)
            message(FATAL_ERROR "The worker runtime carries a separate ${codec}: ${worker_codec}")
        endif()
    endforeach()
    message(STATUS "Codec worker boundary passed: no separate codec library or shim")
endif()
